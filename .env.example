# ─────────────────────────────────────────────────────────────
# Alika — variables de entorno para self-hosting (VPS / Docker) y Vercel
# Copia este archivo como .env y completa los valores.
#
# ⚠️  NUNCA commitear .env. Ya está en .gitignore.
# ─────────────────────────────────────────────────────────────

# ─── Runtime del servidor ──────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Preset de build de Nitro: node-server para VPS/Docker; vercel para Vercel.
NITRO_PRESET=node-server

# ─── Backend (Supabase / Postgres) ─────────────────────────────────
# Se inyectan en el bundle del navegador: deben estar presentes EN BUILD-TIME.
# Se obtienen del dashboard de Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=tu-project-ref

# ⚠️ Solo servidor. NUNCA exponer al navegador ni commitear.
# Se obtiene del mismo dashboard → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: conexión directa a Postgres para migraciones/backups.
SUPABASE_DB_URL=

# ─── URL pública (enlaces en emails, OAuth, sitemap) ───────────────
PUBLIC_APP_URL=https://alika.com

# ─── Inteligencia artificial ───────────────────────────────────────
# Orden de resolución automático: LOVABLE_API_KEY → GEMINI_API_KEY → OPENAI_API_KEY.
# LOVABLE_API_KEY solo funciona dentro del hosting de Lovable.
# Fuera de Lovable, usar la clave del proveedor:
#   Gemini: https://aistudio.google.com/app/apikey
#   OpenAI: https://platform.openai.com/api-keys
GEMINI_API_KEY=
OPENAI_API_KEY=
# Opcionales: forzar proveedor y modelo específico.
# AI_PROVIDER=gemini        # lovable | gemini | openai
# AI_MODEL=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini

# ─── Email (confirmaciones/recordatorios de cita + notificaciones de revisión clínica) ──
# Resend: https://resend.com/api-keys
EMAIL_FROM=avisos@tuclinica.com
RESEND_API_KEY=
# Sin RESEND_API_KEY o EMAIL_FROM no sale ningún email (el intento queda
# registrado como 'failed' con motivo claro, no rompe nada).
#
# El modo sandbox (bloquear/redirigir envíos mientras se valida la
# entregabilidad) YA NO se controla por env var: vive en la tabla
# `email_sandbox_config` por clínica y se edita en /sandbox-email. La misma
# config la lee el servidor al enviar (lib/email.server.ts +
# resolveEmailRecipient) — antes eran dos gates desconectados (localStorage
# vs env var), unificado el 2026-08-26. Default sin fila = modo sandbox.

# ─── Monitoreo — Sentry (errors) ───────────────────────────────────
# Crear proyecto React en https://sentry.io. Copiar el DSN del onboarding.
# El código chequea si está presente; sin DSN no crashea, solo no reporta.
SENTRY_DSN=
# Tag para diferenciar preview/staging/production en Sentry.
SENTRY_ENVIRONMENT=production
# 0.0-1.0. En prod arrancar bajo (0.1) para no llenar cuota gratis.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Analítica — PostHog (product analytics) ───────────────────────
# https://posthog.com/ (cloud EU por privacidad LatAm).
# Sin key no se carga el snippet ni se envían eventos.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Billing — Stripe (pendiente implementar en Fase 7) ────────────
# https://dashboard.stripe.com/apikeys
# Producción: usar keys que empiezan con sk_live_ y pk_live_.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Webhook: crear endpoint en https://alika.com/api/stripe/webhook
# desde el dashboard de Stripe, copiar el signing secret aquí.
STRIPE_WEBHOOK_SECRET=
# Precios de fundador (2026-08-22) — dos tiers, no un flat único.
# No son secretos (aparecen en la URL de checkout), pero igual van por env
# var para poder rotarlos sin redeploy de código. Versión VITE_ (mismo
# valor) para que el cliente pueda mostrar qué plan está activo sin pedirle
# nada al server.
STRIPE_PRICE_ID_SOLO_MONTHLY=
STRIPE_PRICE_ID_CLINIC_MONTHLY=
VITE_STRIPE_PRICE_ID_SOLO_MONTHLY=
VITE_STRIPE_PRICE_ID_CLINIC_MONTHLY=

# ─── Portal del paciente v2 ────────────────────────────────────────
# Secret HMAC (32+ bytes random) para firmar los links del portal.
# Generar con: openssl rand -base64 48
# En dev, si está vacío, se usa un secret hardcoded inseguro (warning en
# consola). En producción es OBLIGATORIO. Rotar invalida todos los links
# firmados existentes (usuarios tendrán que pedir uno nuevo).
PORTAL_TOKEN_SECRET=

# ─── Clínica demo pública ───────────────────────────────────────────
# Secret que valida el request del cron de reset (src/routes/api.demo-reset.ts).
# Generar con: openssl rand -base64 32
# Configurar el mismo valor en vercel.json (crons llama con este Authorization
# header automáticamente en Vercel) y en esta env var.
CRON_SECRET=

# ─── WhatsApp (Fase 1 — Cloud API directo, Alika como Tech Provider) ────
# Sin esto seteado, /whatsapp muestra "todavía no habilitado" y todo sigue
# funcionando por wa.me manual (fallback automático, nunca se rompe nada).
# Requiere enrolarse en el programa Tech Provider de Meta primero:
#   https://developers.facebook.com/docs/whatsapp/tech-provider-program
#
# App ID y App Secret: Meta App Dashboard → Configuración básica.
# App ID NO es secreto (se expone al navegador también, ver VITE_ abajo).
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# System User token con permiso whatsapp_business_messaging +
# whatsapp_business_management. Con este único token se manda en nombre de
# CUALQUIER WABA conectado por una clínica — nunca se guarda un token por
# clínica en la base de datos.
WHATSAPP_SYSTEM_USER_TOKEN=
# String propio (inventalo vos, ej. `openssl rand -hex 16`) para el
# handshake GET del webhook con Meta Business Manager.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Versión de la Graph API fijada, para no romper ante cambios de Meta.
WHATSAPP_API_VERSION=v21.0

# Client-side: mismo App ID de arriba (no es secreto), más el Config ID de
# Embedded Signup (Meta App Dashboard → WhatsApp → Embedded Signup).
VITE_WHATSAPP_APP_ID=
VITE_WHATSAPP_CONFIG_ID=
VITE_WHATSAPP_API_VERSION=v21.0
