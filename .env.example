# ─────────────────────────────────────────────────────────────
# Oralia — variables de entorno para self-hosting (VPS / Docker)
# Copia este archivo como .env y completa los valores.
# ─────────────────────────────────────────────────────────────

# --- Runtime del servidor ---
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Preset de build de Nitro: node-server para VPS/Docker
NITRO_PRESET=node-server

# --- Backend (Supabase / Postgres) ---
# Se inyectan en el bundle del navegador: deben estar presentes EN BUILD-TIME.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=tu-project-ref

# Solo servidor. NUNCA exponer al navegador ni commitear.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: conexión directa a Postgres para migraciones/backups
SUPABASE_DB_URL=

# --- Inteligencia artificial ---
# Orden de resolución automático: LOVABLE_API_KEY -> GEMINI_API_KEY -> OPENAI_API_KEY
# LOVABLE_API_KEY solo funciona dentro del hosting de Lovable.
# Fuera de Lovable usa tu propia clave de proveedor:
GEMINI_API_KEY=
OPENAI_API_KEY=
# Opcionales: forzar proveedor y modelo
# AI_PROVIDER=gemini        # lovable | gemini | openai
# AI_MODEL=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini

# --- Email (opcional, notificaciones de revisión clínica) ---
EMAIL_FROM=avisos@tuclinica.com
RESEND_API_KEY=
# Sandbox: bloquea envíos reales durante la validación
EMAIL_SANDBOX=true
EMAIL_SANDBOX_REDIRECT_TO=qa@tuclinica.com

# --- URL pública (enlaces en emails y OAuth) ---
PUBLIC_APP_URL=https://oralia.tuclinica.com
