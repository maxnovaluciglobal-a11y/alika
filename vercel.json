{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".vercel/output",
  "github": {
    "silent": true
  },
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/demo-reset",
      "schedule": "5 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        }
      ]
    },
    {
      "source": "/_serverFn/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.esmalia.com"
        }
      ],
      "destination": "https://esmalia.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.esmalia.com"
        }
      ],
      "destination": "https://esmalia.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "alika-omega.vercel.app"
        }
      ],
      "destination": "https://esmalia.com/",
      "permanent": true
    },
    {
      "source": "/precios",
      "has": [
        {
          "type": "host",
          "value": "alika-omega.vercel.app"
        }
      ],
      "destination": "https://esmalia.com/precios",
      "permanent": true
    },
    {
      "source": "/software-dental-latam",
      "has": [
        {
          "type": "host",
          "value": "alika-omega.vercel.app"
        }
      ],
      "destination": "https://esmalia.com/software-dental-latam",
      "permanent": true
    },
    {
